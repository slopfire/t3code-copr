+  it("queues a mid-turn send as a steer and runs it in the same turn", async () => {
+    const harness = prepareMockHarness();
+    try {
+      await runScoped(
+        Effect.gen(function* () {
+          const instanceId = ProviderInstanceId.make("commandCodeTest");
+          const threadId = ThreadId.make("thread-steer");
+          const adapter = yield* makeCommandCodeAdapter(makeConfig(harness.binaryPath), {
+            driverKind: ProviderDriverKind.make("commandCode"),
+            instanceId,
+            environment: {
+              ...process.env,
+              T3_MOCK_ARGV_LOG: harness.argvLogPath,
+              // Both runs hold after their first chunk, so the steer always
+              // lands while a child is still working.
+              T3_MOCK_HANG: "1",
+            },
+          });
+          yield* adapter.startSession({ threadId, cwd: harness.cwd, runtimeMode: "full-access" });
+
+          const eventsFiber = yield* Effect.forkScoped(
+            Stream.runCollect(
+              adapter.streamEvents.pipe(
+                Stream.takeUntil((event) => event.type === "turn.completed"),
+              ),
+            ),
+          );
+          const turnStartedFiber = yield* Effect.forkScoped(
+            adapter.streamEvents.pipe(
+              Stream.takeUntil((event) => event.type === "turn.started"),
+              Stream.runDrain,
+            ),
+          );
+          const firstFiber = yield* Effect.forkScoped(
+            adapter.sendTurn({ threadId, input: "primero" }),
+          );
+          // Wait until the turn is reserved and its process is streaming before
+          // sending the follow-up mid-turn.
+          yield* Fiber.join(turnStartedFiber);
+          yield* adapter.streamEvents.pipe(
+            Stream.takeUntil((event) => event.type === "content.delta"),
+            Stream.runDrain,
+          );
+
+          const steered = yield* adapter.sendTurn({ threadId, input: "segundo" });
+
+          const first = yield* Fiber.join(firstFiber);
+          const events = Array.from(yield* Fiber.join(eventsFiber));
+
+          // Steering continues the running turn instead of failing the send.
+          expect(steered.turnId).toBe(first.turnId);
+          expect(events.filter((event) => event.type === "turn.started")).toHaveLength(1);
+          expect(events.at(-1)?.type).toBe("turn.completed");
+
+          // The queued prompt ran after the first process exited, resuming the
+          // same Command Code session.
+          const steeredArgv = readArgvLog(harness.argvLogPath);
+          expect(steeredArgv.prompt).toBe("segundo");
+          expect(steeredArgv.argv).toContain("--resume");
+          expect(steeredArgv.argv).toContain("mock-session-1");
+        }),
+      );
+    } finally {
+      harness.cleanup();
+    }
+  }, 30_000);
