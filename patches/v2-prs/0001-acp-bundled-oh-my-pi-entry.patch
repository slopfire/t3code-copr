+/**
+ * ACP agents T3 Code ships locally so they are installable before their entry
+ * lands in the official ACP Registry. These entries are validated exactly like
+ * fetched Registry entries and merged behind them: the first entry with a given
+ * id wins, so an official Registry listing supersedes its bundled copy as soon
+ * as it appears. Keep this list to agents missing from the Registry and pin
+ * exact package versions.
+ */
+export const bundledAcpRegistryAgents = [
+  {
+    id: "omp",
+    name: "Oh My Pi",
+    version: "18.2.3",
+    description: "Coding agent CLI with read, bash, edit, write tools and session management",
+    authors: ["can1357"],
+    license: "MIT",
+    repository: "https://github.com/can1357/oh-my-pi",
+    distribution: {
+      npx: {
+        package: "@oh-my-pi/pi-coding-agent@18.2.3",
+        args: ["acp"],
+      },
+    },
+  },
+] as const;
